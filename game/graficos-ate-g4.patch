diff --git a/game/scripts/phase3_boss_view.gd b/game/scripts/phase3_boss_view.gd
new file mode 100644
index 0000000..488204d
--- /dev/null
+++ b/game/scripts/phase3_boss_view.gd
@@ -0,0 +1,343 @@
+extends Control
+
+# Planta da Sala de Controlo durante o confronto (vista de cima).
+#
+# Só desenha: lê o estado do confronto (phase3_boss.gd) em cada frame e
+# nunca o altera. Tudo é feito com _draw() (retângulos, círculos, arcos),
+# sem imagens.
+#
+#   - portas que deslizam a fechar/abrir;
+#   - brilho vermelho no corredor, que cresce com a temperatura do sensor
+#     (a criatura em si não se vê: não há câmaras);
+#   - termómetros junto a cada porta;
+#   - anel de progresso do Hangar, Player na consola e Atlas a trabalhar;
+#   - tremor quando a criatura bate numa porta, clarão vermelho e a
+#     silhueta da criatura quando entra, luzes de emergência sem energia.
+
+const UIStyle := preload("res://scripts/ui_style.gd")
+const CharacterFrames := preload("res://scripts/character_frames.gd")
+
+const VIEW_SIZE := Vector2(1000.0, 300.0)
+const ROOM := Rect2(200.0, 14.0, 600.0, 272.0)
+const WALL := 12.0
+const DOOR_HEIGHT := 92.0
+const DOOR_SPEED := 6.0            # fração da porta por segundo (~0,17 s)
+const INTRUDER_TIME := 1.4         # quanto tempo a criatura fica à vista ao entrar
+const INTRUDER_WALK := 0.5         # dos quais a passar a porta
+
+const FLOOR_COLOR := Color(0.11, 0.13, 0.16)
+const GRID_COLOR := Color(0.16, 0.19, 0.23)
+const WALL_COLOR := Color(0.55, 0.62, 0.68)
+const CORRIDOR_COLOR := Color(0.07, 0.08, 0.1)
+const DOOR_COLOR := Color(0.36, 0.4, 0.45)
+const HAZARD := Color(0.85, 0.68, 0.16)
+const HEAT := Color(1.0, 0.32, 0.12)
+const ATLAS_BODY := Color(0.95, 0.85, 0.3)
+const PLAYER_BODY := Color(0.88, 0.92, 0.95)
+
+var boss: Node = null
+var clock: float = 0.0
+var door_amount: Dictionary = {"left": 0.0, "right": 0.0}   # 0 aberta, 1 fechada
+var shake: float = 0.0
+var flash: float = 0.0
+var flash_color: Color = Color.WHITE
+var knock_side: String = ""
+var knock_time: float = 0.0
+var intruder_side: String = ""
+var intruder_time: float = 0.0
+var base_offset: Vector2 = Vector2.ZERO
+var spark_rng := RandomNumberGenerator.new()   # só para efeitos; não mexe no confronto
+
+
+func _init() -> void:
+	custom_minimum_size = VIEW_SIZE
+	mouse_filter = Control.MOUSE_FILTER_IGNORE
+
+
+func bind(target: Node) -> void:
+	boss = target
+	boss.door_knocked.connect(_on_door_knocked)
+	boss.creature_entered.connect(_on_creature_entered)
+
+
+func _on_door_knocked(side: String) -> void:
+	knock_side = side
+	knock_time = 0.6
+	shake = 8.0
+	flash = 0.25
+	flash_color = Color(1.0, 1.0, 1.0)
+
+
+func _on_creature_entered(side: String) -> void:
+	intruder_side = side
+	intruder_time = INTRUDER_TIME
+	shake = 14.0
+	flash = 0.6
+	flash_color = Color(0.9, 0.05, 0.05)
+
+
+func _process(delta: float) -> void:
+	clock += delta
+	if boss != null:
+		for side in ["left", "right"]:
+			var target: float = 1.0 if boss.doors_closed[side] else 0.0
+			door_amount[side] = move_toward(door_amount[side], target, DOOR_SPEED * delta)
+	shake = max(0.0, shake - 30.0 * delta)
+	flash = max(0.0, flash - 1.2 * delta)
+	knock_time = max(0.0, knock_time - delta)
+	intruder_time = max(0.0, intruder_time - delta)
+	queue_redraw()
+
+
+# 0 a 1: quão quente está o lado (12 °C → 0, 39 °C → 1).
+func heat_of(side: String) -> float:
+	if boss == null:
+		return 0.0
+	return clamp((float(boss.sensor_readings[side]) - 12.0) / 27.0, 0.0, 1.0)
+
+
+func door_rect(side: String) -> Rect2:
+	var y := ROOM.get_center().y - DOOR_HEIGHT / 2.0
+	var x := ROOM.position.x - WALL / 2.0 if side == "left" else ROOM.end.x - WALL / 2.0
+	return Rect2(x, y, WALL, DOOR_HEIGHT)
+
+
+func _draw() -> void:
+	if boss == null:
+		return
+	var offset := Vector2.ZERO
+	if shake > 0.0:
+		offset = Vector2(spark_rng.randf_range(-shake, shake), spark_rng.randf_range(-shake, shake)) * 0.5
+	base_offset = offset + (size - VIEW_SIZE) / 2.0
+	draw_set_transform(base_offset, 0.0, Vector2.ONE)
+
+	draw_corridors()
+	draw_room()
+	for side in ["left", "right"]:
+		draw_door(side)
+		draw_thermometer(side)
+	draw_hangar_ring()
+	draw_console()
+	draw_player(Vector2(470.0, 96.0))
+	draw_atlas(Vector2(532.0, 96.0))
+	if intruder_time > 0.0:
+		draw_intruder(intruder_side)
+	if boss.power_out:
+		draw_power_out()
+
+	draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
+	if flash > 0.0:
+		draw_rect(Rect2(Vector2.ZERO, size), Color(flash_color, flash * 0.5))
+
+
+func draw_corridors() -> void:
+	var center_y := ROOM.get_center().y
+	for side in ["left", "right"]:
+		var x := 0.0 if side == "left" else ROOM.end.x
+		var corridor := Rect2(x, center_y - DOOR_HEIGHT / 2.0 - 8.0, ROOM.position.x, DOOR_HEIGHT + 16.0)
+		draw_rect(corridor, CORRIDOR_COLOR)
+		# Riscas no chão do corredor, para dar profundidade.
+		for i in 6:
+			var line_x := corridor.position.x + 18.0 + i * 30.0
+			draw_line(Vector2(line_x, corridor.position.y + 6.0), Vector2(line_x, corridor.end.y - 6.0), Color(0.12, 0.13, 0.16), 2.0)
+		# Calor: brilho que cresce com a leitura do sensor.
+		var heat := heat_of(side)
+		if heat > 0.05:
+			var pulse := 0.85 + 0.15 * sin(clock * 6.0)
+			draw_rect(corridor, Color(HEAT, heat * 0.35 * pulse))
+			var door_x := ROOM.position.x - 30.0 if side == "left" else ROOM.end.x + 30.0
+			for ring in 6:
+				draw_circle(Vector2(door_x, center_y), 18.0 + ring * 16.0, Color(HEAT, heat * 0.09 * pulse))
+
+
+func draw_room() -> void:
+	draw_rect(ROOM, FLOOR_COLOR)
+	var step := 34.0
+	var x := ROOM.position.x + step
+	while x < ROOM.end.x:
+		draw_line(Vector2(x, ROOM.position.y), Vector2(x, ROOM.end.y), GRID_COLOR, 1.0)
+		x += step
+	var y := ROOM.position.y + step
+	while y < ROOM.end.y:
+		draw_line(Vector2(ROOM.position.x, y), Vector2(ROOM.end.x, y), GRID_COLOR, 1.0)
+		y += step
+	# Paredes, com as aberturas das portas.
+	var door_top := ROOM.get_center().y - DOOR_HEIGHT / 2.0
+	var door_bottom := door_top + DOOR_HEIGHT
+	draw_rect(Rect2(ROOM.position.x - WALL / 2.0, ROOM.position.y - WALL / 2.0, ROOM.size.x + WALL, WALL), WALL_COLOR)
+	draw_rect(Rect2(ROOM.position.x - WALL / 2.0, ROOM.end.y - WALL / 2.0, ROOM.size.x + WALL, WALL), WALL_COLOR)
+	for wall_x in [ROOM.position.x - WALL / 2.0, ROOM.end.x - WALL / 2.0]:
+		draw_rect(Rect2(wall_x, ROOM.position.y, WALL, door_top - ROOM.position.y), WALL_COLOR)
+		draw_rect(Rect2(wall_x, door_bottom, WALL, ROOM.end.y - door_bottom), WALL_COLOR)
+
+
+func draw_door(side: String) -> void:
+	var opening := door_rect(side)
+	var amount: float = door_amount[side]
+	# A porta desce do topo da abertura.
+	if amount > 0.01:
+		var slab := Rect2(opening.position.x - 3.0, opening.position.y, opening.size.x + 6.0, opening.size.y * amount)
+		var color := DOOR_COLOR
+		if knock_side == side and knock_time > 0.0:
+			color = color.lerp(Color.WHITE, knock_time)
+		draw_rect(slab, color)
+		var stripe_y := slab.position.y + 4.0
+		while stripe_y < slab.end.y - 6.0:
+			draw_rect(Rect2(slab.position.x, stripe_y, slab.size.x, 5.0), HAZARD)
+			stripe_y += 14.0
+	# Luz de estado por cima da porta: verde aberta, ciano fechada.
+	var light := Vector2(opening.get_center().x, opening.position.y - 14.0)
+	var light_color := UIStyle.ACCENT if boss.doors_closed[side] else Color(0.3, 0.8, 0.35)
+	if boss.power_out:
+		light_color = Color(0.3, 0.3, 0.3)
+	draw_circle(light, 5.0, light_color)
+	var key := "A" if side == "left" else "D"
+	var font := get_theme_default_font()
+	var label_x := opening.position.x - 40.0 if side == "left" else opening.end.x + 24.0
+	draw_string(font, Vector2(label_x, opening.end.y + 28.0), "[" + key + "]", HORIZONTAL_ALIGNMENT_LEFT, -1, 16, UIStyle.TEXT_MUTED)
+
+
+func draw_thermometer(side: String) -> void:
+	var heat := heat_of(side)
+	var x := ROOM.position.x + 34.0 if side == "left" else ROOM.end.x - 46.0
+	var tube := Rect2(x, ROOM.position.y + 40.0, 12.0, 150.0)
+	draw_rect(tube, Color(0.05, 0.06, 0.08))
+	var fill_height: float = tube.size.y * max(0.08, heat)
+	var cold := Color(0.25, 0.55, 0.9)
+	var fill_color := cold.lerp(HEAT, heat)
+	draw_rect(Rect2(tube.position.x, tube.end.y - fill_height, tube.size.x, fill_height), fill_color)
+	draw_rect(tube, Color(0.4, 0.45, 0.5), false, 1.0)
+	draw_circle(Vector2(tube.get_center().x, tube.end.y + 8.0), 10.0, fill_color)
+	# Marca dos 28 °C (zona de perigo).
+	var mark_y := tube.end.y - tube.size.y * ((28.0 - 12.0) / 27.0)
+	draw_line(Vector2(tube.position.x - 4.0, mark_y), Vector2(tube.end.x + 4.0, mark_y), UIStyle.DANGER, 2.0)
+	var font := get_theme_default_font()
+	var text := str(snapped(float(boss.sensor_readings[side]), 0.1)) + "°"
+	draw_string(font, Vector2(tube.position.x - 14.0, tube.end.y + 40.0), text, HORIZONTAL_ALIGNMENT_LEFT, -1, 15,
+		UIStyle.DANGER if float(boss.sensor_readings[side]) >= 28.0 else UIStyle.TEXT)
+
+
+func draw_hangar_ring() -> void:
+	var center := Vector2(500.0, 205.0)
+	var progress: float = 1.0 - float(boss.time_left) / float(boss.DURATION)
+	draw_arc(center, 46.0, 0.0, TAU, 48, Color(0.18, 0.22, 0.26), 8.0)
+	draw_arc(center, 46.0, -PI / 2.0, -PI / 2.0 + TAU * progress, 48, UIStyle.ACCENT, 8.0)
+	var font := get_theme_default_font()
+	var seconds := str(int(ceil(float(boss.time_left)))) + " s"
+	draw_string(font, center + Vector2(-46.0, 6.0), seconds, HORIZONTAL_ALIGNMENT_CENTER, 92.0, 20, UIStyle.TEXT)
+	draw_string(font, center + Vector2(-46.0, 74.0), "HANGAR", HORIZONTAL_ALIGNMENT_CENTER, 92.0, 13, UIStyle.TEXT_MUTED)
+
+
+func draw_console() -> void:
+	var desk := Rect2(420.0, 26.0, 160.0, 40.0)
+	draw_rect(desk, Color(0.2, 0.24, 0.29))
+	for i in 3:
+		var screen := Rect2(desk.position.x + 10.0 + i * 50.0, desk.position.y + 7.0, 40.0, 24.0)
+		var glow := 0.6 + 0.4 * sin(clock * 3.0 + i)
+		var color := Color(0.15, 0.55, 0.55).lerp(UIStyle.ACCENT, glow)
+		if boss.power_out:
+			color = Color(0.12, 0.14, 0.16)
+		draw_rect(screen, color)
+
+
+# Desenha um sprite com os pés em "feet". Devolve false se não houver PNG.
+func draw_sprite(texture: Texture2D, feet: Vector2, height: float, tint: Color = Color.WHITE, flip: bool = false) -> bool:
+	if texture == null:
+		return false
+	var width := height * texture.get_width() / texture.get_height()
+	var rect := Rect2(feet.x - width / 2.0, feet.y - height, width, height)
+	draw_ellipse_shadow(feet, min(width, height * 0.6) * 0.35)
+	if flip:
+		# Espelho horizontal à volta dos pés.
+		draw_set_transform(base_offset + Vector2(feet.x * 2.0, 0.0), 0.0, Vector2(-1.0, 1.0))
+	draw_texture_rect(texture, rect, false, tint)
+	if flip:
+		draw_set_transform(base_offset, 0.0, Vector2.ONE)
+	return true
+
+
+func draw_ellipse_shadow(feet: Vector2, radius: float) -> void:
+	var points := PackedVector2Array()
+	for i in 16:
+		var angle := TAU * i / 16.0
+		points.append(feet + Vector2(cos(angle) * radius, sin(angle) * radius * 0.3))
+	draw_colored_polygon(points, Color(0, 0, 0, 0.3))
+
+
+func draw_player(at: Vector2) -> void:
+	var bob := sin(clock * 2.0) * 1.5
+	var body := at + Vector2(0.0, bob)
+	# De costas, virado para a consola.
+	if draw_sprite(CharacterFrames.first_texture("player", "idle_back"), at + Vector2(0.0, 26.0), 56.0):
+		return
+	draw_circle(body + Vector2(0.0, 14.0), 13.0, Color(0.7, 0.75, 0.8))     # mochila / corpo
+	draw_circle(body, 13.0, PLAYER_BODY)                                       # capacete
+	draw_arc(body + Vector2(0.0, -2.0), 8.0, PI * 1.1, PI * 1.9, 12, UIStyle.ACCENT, 4.0)   # visor
+
+
+func draw_atlas(at: Vector2) -> void:
+	var damaged: bool = boss.atlas_damaged
+	var bob := sin(clock * 2.6 + 1.0) * 1.5
+	var body := at + Vector2(0.0, bob)
+	var color := ATLAS_BODY.lerp(Color(0.8, 0.3, 0.25), 0.5) if damaged else ATLAS_BODY
+	var tint := Color(1.0, 0.55, 0.5) if damaged else Color.WHITE
+	if not draw_sprite(CharacterFrames.first_texture("atlas", "idle_front"), at + Vector2(0.0, 26.0 + bob), 56.0, tint):
+		draw_rect(Rect2(body.x - 11.0, body.y + 2.0, 22.0, 24.0), color)
+		draw_circle(body, 11.0, color)
+		var eye_color := UIStyle.DANGER if damaged else UIStyle.ACCENT
+		draw_circle(body + Vector2(0.0, -1.0), 4.0, eye_color)
+		draw_line(body + Vector2(0.0, -11.0), body + Vector2(0.0, -20.0), color, 2.0)
+		if fmod(clock, 1.0) < 0.5:
+			draw_circle(body + Vector2(0.0, -21.0), 2.5, eye_color)
+	# Feixe de dados para a consola enquanto abre o Hangar.
+	if boss.running and not boss.power_out:
+		var start := body + Vector2(0.0, -12.0)
+		var finish := Vector2(540.0, 66.0)
+		var segments := 6
+		for i in segments:
+			if (i + int(clock * 8.0)) % 2 == 0:
+				draw_line(start.lerp(finish, float(i) / segments), start.lerp(finish, float(i + 1) / segments), Color(UIStyle.ACCENT, 0.7), 2.0)
+	if damaged:
+		for i in 3:
+			var spark := body + Vector2(spark_rng.randf_range(-16.0, 16.0), spark_rng.randf_range(-14.0, 24.0))
+			if spark_rng.randf() < 0.4:
+				draw_line(spark, spark + Vector2(spark_rng.randf_range(-6.0, 6.0), spark_rng.randf_range(-6.0, 6.0)), HAZARD, 2.0)
+
+
+# Frame da animação da criatura ao fim de "time" segundos (null sem PNG).
+func monster_frame(animation: String, time: float) -> Texture2D:
+	var frames := CharacterFrames.frames_for("monster")
+	if frames == null or not frames.has_animation(animation):
+		return null
+	var count := frames.get_frame_count(animation)
+	return frames.get_frame_texture(animation, int(time * frames.get_animation_speed(animation)) % count)
+
+
+# A criatura só aparece no instante em que entra.
+func draw_intruder(side: String) -> void:
+	var opening := door_rect(side)
+	var center := Vector2(opening.get_center().x + (50.0 if side == "left" else -50.0), opening.get_center().y)
+	var alpha: float = clamp(intruder_time, 0.0, 1.0)
+	# Entra a andar pela porta (primeiro meio segundo) e depois ataca.
+	# As frames da criatura olham para a direita: pela porta direita, espelha.
+	var elapsed: float = INTRUDER_TIME - intruder_time
+	var walking: bool = elapsed < INTRUDER_WALK
+	var walk_from := Vector2(opening.get_center().x + (-40.0 if side == "left" else 40.0), opening.get_center().y)
+	var feet := walk_from.lerp(center, clamp(elapsed / INTRUDER_WALK, 0.0, 1.0)) + Vector2(0.0, 40.0)
+	var texture := monster_frame("walk_side" if walking else "attack", elapsed)
+	if draw_sprite(texture, feet, 96.0, Color(1, 1, 1, alpha), side == "right"):
+		return
+	draw_circle(center, 34.0, Color(0.03, 0.02, 0.02, alpha))
+	draw_circle(center + Vector2(0.0, -24.0), 22.0, Color(0.03, 0.02, 0.02, alpha))
+	draw_circle(center + Vector2(-8.0, -26.0), 4.0, Color(1.0, 0.15, 0.1, alpha))
+	draw_circle(center + Vector2(8.0, -26.0), 4.0, Color(1.0, 0.15, 0.1, alpha))
+
+
+func draw_power_out() -> void:
+	draw_rect(Rect2(Vector2.ZERO, VIEW_SIZE), Color(0.0, 0.0, 0.0, 0.55))
+	if fmod(clock, 0.8) < 0.4:
+		for corner in [ROOM.position + Vector2(16, 16), Vector2(ROOM.end.x - 16, ROOM.position.y + 16),
+				Vector2(ROOM.position.x + 16, ROOM.end.y - 16), ROOM.end - Vector2(16, 16)]:
+			draw_circle(corner, 14.0, Color(0.9, 0.1, 0.1, 0.5))
+	var font := get_theme_default_font()
+	draw_string(font, Vector2(0.0, ROOM.position.y + 40.0), "SEM ENERGIA", HORIZONTAL_ALIGNMENT_CENTER, VIEW_SIZE.x, 22, UIStyle.DANGER)
diff --git a/game/scripts/tutorial_card.gd b/game/scripts/tutorial_card.gd
new file mode 100644
index 0000000..2da29de
--- /dev/null
+++ b/game/scripts/tutorial_card.gd
@@ -0,0 +1,252 @@
+extends CanvasLayer
+
+# Cartão de tutorial: explica uma mecânica na primeira vez que ela aparece.
+#
+# Uso:
+#   TutorialCard.show_once(self, "fight")   # só abre se ainda não foi visto
+#   TutorialCard.open(self, "fight")        # abre sempre (menu COMO JOGAR)
+#
+# Enquanto o cartão está aberto:
+#   - o jogo fica pausado (e volta ao estado anterior ao fechar);
+#   - os temporizadores do AlienEncounterManager e do FightManager param
+#     (eles correm com PROCESS_MODE_ALWAYS, por isso perguntam is_open());
+#   - o cartão fica com todas as teclas, para não irem parar ao jogo.
+#
+# O que já foi visto fica na run, em custom.tutorial_<id>, e vai no save.
+# Os textos descrevem as regras que estão no código; não mudam nenhuma.
+
+const UIStyle := preload("res://scripts/ui_style.gd")
+
+const GROUP := "tutorial_card"
+const LAYER := 1500
+
+# Ordem do menu COMO JOGAR.
+const ORDER := ["controls", "encounter", "run", "fight", "hide", "hack", "boss"]
+
+const TUTORIALS := {
+	"controls": {
+		"title": "CONTROLOS BÁSICOS",
+		"steps": [
+			["W A S D", "Mover o Player."],
+			["E", "Interagir com terminais, portas, peças e equipamentos."],
+			["ESPAÇO", "O Atlas analisa o que está à volta."],
+			["ESC", "Pausa: gravar, carregar, COMO JOGAR."],
+			["CHAT", "Escreve na caixa de texto em baixo para falar com o Atlas."],
+		],
+		"tip": "Se não souberes o que fazer, pergunta ao Atlas.",
+	},
+	"encounter": {
+		"title": "ENCONTRO COM A CRIATURA",
+		"steps": [
+			["!", "A criatura pode aparecer nos corredores. O jogo para até escolheres o que fazer."],
+			["RUN", "Fugir: carregas ESPAÇO depressa e depois passas uma porta com um hack antes de ela vos apanhar."],
+			["FIGHT", "Lutar: só aparece depois de ligares o equipamento sonoro ao Atlas. Se venceres, o corredor seguinte fica seguro."],
+		],
+		"tip": "Cada fuga torna um novo encontro mais provável.",
+	},
+	"run": {
+		"title": "FUGIR (RUN)",
+		"steps": [
+			["ESPAÇO", "Carrega repetidamente até encher a barra."],
+			["HACK", "Depois, abre a porta com um hack e fecha-a atrás de vocês com outro."],
+			["15 s", "Tens 15 segundos para selar a porta. Se o tempo acabar, a criatura apanha-vos: Game Over."],
+		],
+		"tip": "No hack, lê a regra no topo do ecrã: cada protocolo é diferente.",
+	},
+	"fight": {
+		"title": "LUTA SONORA (FIGHT)",
+		"steps": [
+			["1. AJUSTE", "Antes de cada ataque escolhe uma carta: +10 VIDA, +3 DANO SONORO, ou +5 VIDA e +2 DANO."],
+			["2. DESVIAR", "Durante 6 s desvia-te das garras e mordidas com W A S D. [1] controla o Player, [2] o Atlas. Cada golpe tira 3 de VIDA."],
+			["3. POSIÇÃO", "Em 5 s leva o Player para a zona AZUL e o Atlas para a zona VERMELHA. Player fora da zona: -1 VIDA."],
+			["VITÓRIA", "Atlas na zona vermelha com DANO SONORO de 10 ou mais: a onda sonora afasta a criatura."],
+		],
+		"tip": "O dano começa em 1: três cartas de +3 chegam aos 10. A VIDA é partilhada; se chegar a 0, perdem.",
+	},
+	"hide": {
+		"title": "ESCONDER (HIDE)",
+		"steps": [
+			["!", "A criatura pode entrar na sala onde estás."],
+			["IR", "Segue o Atlas ou a marca até ao esconderijo antes de o tempo acabar."],
+			["FICAR", "Fica lá dentro, sem sair, até o temporizador terminar e ela ir embora."],
+			["FALHAR", "Se não chegares a tempo ou saíres antes, ela encontra-vos e só podem fugir (RUN)."],
+		],
+		"tip": "O temporizador no topo do ecrã diz quanto falta.",
+	},
+	"hack": {
+		"title": "HACKS",
+		"steps": [
+			["SORTEIO", "Cada hack é um minijogo sorteado: setas, contar teclas, memória de cores, matriz, rotas, texto."],
+			["REGRA", "A regra está sempre escrita no topo do ecrã. Lê-a antes de começar."],
+			["ERRAR", "Se errares aparece ACCESS DENIED e tens de tentar outra vez."],
+		],
+		"tip": "Durante uma fuga o relógio continua a contar enquanto fazes o hack.",
+	},
+	"boss": {
+		"title": "SALA DE CONTROLO",
+		"steps": [
+			["60 s", "O Atlas precisa de 60 segundos para abrir o Hangar."],
+			["SENSOR", "A criatura é quente: ~12 °C longe, 21 no corredor, 30 perto, 39 à porta."],
+			["A / D", "Fecham e abrem as portas. Uma porta fechada aguenta 25 s de energia, as duas 12,5 s."],
+			["2,5 s", "À porta, ela espera 2,5 s. Porta aberta: entra e o Atlas fica danificado, o que muda o final."],
+		],
+		"tip": "Fecha só a porta que ficar vermelha e abre-a quando arrefecer.",
+	},
+}
+
+var tutorial_id: String = ""
+var was_paused: bool = false
+var panel: Control = null
+
+signal closed(tutorial_id: String)
+
+
+static func is_open(tree: SceneTree) -> bool:
+	return tree != null and tree.get_nodes_in_group(GROUP).size() > 0
+
+
+static func seen_key(id: String) -> String:
+	return "tutorial_" + id
+
+
+static func was_seen(id: String) -> bool:
+	return bool(SaveManager.get_run_value("custom", seen_key(id), false))
+
+
+# Abre o tutorial só na primeira vez nesta run. Devolve o cartão ou null.
+static func show_once(host: Node, id: String) -> Node:
+	if was_seen(id):
+		return null
+	SaveManager.set_run_value("custom", seen_key(id), true)
+	return open(host, id)
+
+
+static func open(host: Node, id: String) -> Node:
+	if host == null or not host.is_inside_tree() or not TUTORIALS.has(id):
+		return null
+	var tree := host.get_tree()
+	# Nunca dois cartões ao mesmo tempo.
+	for other in tree.get_nodes_in_group(GROUP):
+		other.close()
+	var card = load("res://scripts/tutorial_card.gd").new()
+	card.tutorial_id = id
+	var parent: Node = tree.current_scene if tree.current_scene != null else tree.root
+	parent.add_child(card)
+	return card
+
+
+func _ready() -> void:
+	add_to_group(GROUP)
+	layer = LAYER
+	process_mode = Node.PROCESS_MODE_ALWAYS
+	was_paused = get_tree().paused
+	get_tree().paused = true
+	panel = build(TUTORIALS[tutorial_id])
+	add_child(panel)
+
+
+func close() -> void:
+	if not is_inside_tree():
+		return
+	remove_from_group(GROUP)
+	get_tree().paused = was_paused
+	closed.emit(tutorial_id)
+	queue_free()
+
+
+# Todas as teclas ficam no cartão. ESPAÇO, ENTER ou ESC fecham-no.
+func _input(event: InputEvent) -> void:
+	if not is_in_group(GROUP) or not event is InputEventKey:
+		return
+	get_viewport().set_input_as_handled()
+	if event.pressed and not event.echo and event.keycode in [KEY_SPACE, KEY_ENTER, KEY_KP_ENTER, KEY_ESCAPE]:
+		close()
+
+
+func build(data: Dictionary) -> Control:
+	var shade := ColorRect.new()
+	shade.name = "TutorialShade"
+	shade.color = Color(0.0, 0.0, 0.0, 0.82)
+	shade.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	shade.mouse_filter = Control.MOUSE_FILTER_STOP
+	UIStyle.apply(shade)
+
+	var center := CenterContainer.new()
+	center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	shade.add_child(center)
+
+	var frame := PanelContainer.new()
+	center.add_child(frame)
+
+	var box := VBoxContainer.new()
+	box.custom_minimum_size = Vector2(760.0, 0.0)
+	box.add_theme_constant_override("separation", 14)
+	frame.add_child(box)
+
+	var kicker := Label.new()
+	kicker.text = "COMO JOGAR"
+	kicker.add_theme_font_size_override("font_size", 14)
+	UIStyle.subtitle(kicker)
+	box.add_child(kicker)
+
+	var title := Label.new()
+	title.name = "Title"
+	title.text = data["title"]
+	title.add_theme_font_size_override("font_size", 28)
+	UIStyle.title(title)
+	box.add_child(title)
+
+	box.add_child(HSeparator.new())
+
+	for step in data["steps"]:
+		var row := HBoxContainer.new()
+		row.add_theme_constant_override("separation", 16)
+		box.add_child(row)
+		row.add_child(key_chip(step[0]))
+		var text := Label.new()
+		text.text = step[1]
+		text.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+		text.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+		text.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
+		text.add_theme_font_size_override("font_size", 17)
+		row.add_child(text)
+
+	if data.has("tip"):
+		var tip := Label.new()
+		tip.text = "Dica: " + data["tip"]
+		tip.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+		tip.add_theme_font_size_override("font_size", 16)
+		tip.add_theme_color_override("font_color", UIStyle.ACCENT)
+		box.add_child(tip)
+
+	var button := Button.new()
+	button.name = "OkButton"
+	button.text = "PERCEBI  [ESPAÇO]"
+	button.custom_minimum_size = Vector2(280.0, 50.0)
+	button.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
+	button.focus_mode = Control.FOCUS_NONE
+	button.pressed.connect(close)
+	box.add_child(button)
+	return shade
+
+
+# Tecla ou palavra-chave desenhada como uma tecla do teclado.
+func key_chip(text: String) -> PanelContainer:
+	var chip := PanelContainer.new()
+	chip.custom_minimum_size = Vector2(120.0, 40.0)
+	var style := StyleBoxFlat.new()
+	style.bg_color = UIStyle.BUTTON_BG_HOVER
+	style.border_color = UIStyle.ACCENT_DIM
+	style.set_border_width_all(1)
+	style.border_width_bottom = 4
+	style.set_corner_radius_all(6)
+	style.set_content_margin_all(6.0)
+	chip.add_theme_stylebox_override("panel", style)
+	var label := Label.new()
+	label.text = text
+	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
+	label.add_theme_font_size_override("font_size", 16)
+	label.add_theme_color_override("font_color", UIStyle.ACCENT)
+	chip.add_child(label)
+	return chip
diff --git a/game/scripts/character_frames.gd b/game/scripts/character_frames.gd
new file mode 100644
index 0000000..abf4ace
--- /dev/null
+++ b/game/scripts/character_frames.gd
@@ -0,0 +1,86 @@
+extends RefCounted
+
+# Animações do Player, do Atlas e da criatura, montadas a partir dos PNG em
+# res://sprites/characters/<personagem>/<linha>_<n>.png.
+#
+# As imagens foram recortadas das folhas de sprites do projeto (uma pasta por
+# personagem, frame 0 = IDLE, frames 1 a 4 = WALK; "side" olha para a
+# direita). As vistas que faltavam nas folhas (Player de lado, Atlas de
+# costas e de lado) foram feitas no mesmo estilo pela ferramenta
+# 3_vistas_em_falta.py. Para trocar um sprite,
+# basta substituir o PNG com o mesmo nome; o código não muda.
+#
+# Se uma pasta não existir, frames_for() devolve null e quem a usa mantém o
+# visual antigo (o quadrado de cor).
+
+const ROOT := "res://sprites/characters/"
+
+# animação -> [ficheiros, fps, repetir]
+const ANIMATIONS := {
+	"player": {
+		"idle_front": [["front_0"], 1.0, true],
+		"walk_front": [["front_1", "front_2", "front_3", "front_4"], 8.0, true],
+		"idle_back": [["back_0"], 1.0, true],
+		"walk_back": [["back_1", "back_2", "back_3", "back_4"], 8.0, true],
+		"idle_side": [["side_0"], 1.0, true],
+		"walk_side": [["side_1", "side_2", "side_3", "side_4"], 8.0, true],
+	},
+	"atlas": {
+		"idle_front": [["front_0"], 1.0, true],
+		"walk_front": [["front_1", "front_2", "front_3", "front_4"], 8.0, true],
+		"idle_back": [["back_0"], 1.0, true],
+		"walk_back": [["back_1", "back_2", "back_3", "back_4"], 8.0, true],
+		"idle_side": [["side_0"], 1.0, true],
+		"walk_side": [["side_1", "side_2", "side_3", "side_2"], 8.0, true],
+	},
+	"monster": {
+		"idle_front": [["front_0"], 1.0, true],
+		"walk_front": [["front_1", "front_2", "front_3", "front_4"], 7.0, true],
+		"idle_back": [["back_0"], 1.0, true],
+		"walk_back": [["back_1", "back_2", "back_3", "back_4"], 7.0, true],
+		"walk_side": [["side_0", "side_1", "side_2", "side_1"], 7.0, true],
+		"attack": [["side_3", "alert_0", "alert_1", "alert_0"], 8.0, true],
+		"hurt": [["alert_2"], 1.0, false],
+		"roar": [["alert_3", "alert_4"], 4.0, true],
+	},
+}
+
+static var _cache: Dictionary = {}
+
+
+static func frames_for(character: String) -> SpriteFrames:
+	if _cache.has(character):
+		return _cache[character]
+	if not ANIMATIONS.has(character):
+		return null
+	var frames := SpriteFrames.new()
+	frames.remove_animation("default")
+	for animation in ANIMATIONS[character]:
+		var info: Array = ANIMATIONS[character][animation]
+		frames.add_animation(animation)
+		frames.set_animation_speed(animation, info[1])
+		frames.set_animation_loop(animation, info[2])
+		for file_name in info[0]:
+			var texture := texture_for(character, file_name)
+			if texture == null:
+				_cache[character] = null
+				return null
+			frames.add_frame(animation, texture)
+	_cache[character] = frames
+	return frames
+
+
+static func texture_for(character: String, file_name: String) -> Texture2D:
+	var path := ROOT + character + "/" + file_name + ".png"
+	if not ResourceLoader.exists(path):
+		push_warning("Sprite em falta: " + path)
+		return null
+	return load(path)
+
+
+# Primeiro frame de uma animação (para desenhar com draw_texture).
+static func first_texture(character: String, animation: String) -> Texture2D:
+	var frames := frames_for(character)
+	if frames == null or not frames.has_animation(animation):
+		return null
+	return frames.get_frame_texture(animation, 0)
diff --git a/game/scripts/character_sprite.gd b/game/scripts/character_sprite.gd
new file mode 100644
index 0000000..db7a335
--- /dev/null
+++ b/game/scripts/character_sprite.gd
@@ -0,0 +1,97 @@
+extends AnimatedSprite2D
+
+# Sprite animado de uma personagem no mundo.
+#
+# Ligado a um CharacterBody2D (Player ou Atlas), escolhe a animação pela
+# velocidade do corpo: para cima usa as costas, para baixo a frente e para os
+# lados a vista de lado (espelhada para a esquerda). Parado, fica no IDLE da
+# última direção.
+# O quadrado de cor antigo (filho "Polygon2D") fica escondido; se os PNG não
+# existirem, nada muda e o quadrado continua visível.
+#
+# Também serve para a criatura, sem corpo: monster() cria um sprite que só
+# toca uma animação fixa.
+
+const CharacterFrames := preload("res://scripts/character_frames.gd")
+
+const MOVE_THRESHOLD := 5.0
+
+var body: CharacterBody2D = null
+var facing: String = "front"
+var facing_left: bool = false
+
+
+# Põe o sprite no corpo. height = altura no mundo, em píxeis. Os pés ficam
+# na base da colisão (raio feet_y abaixo do centro).
+static func attach(target: CharacterBody2D, character: String, height: float = 84.0, feet_y: float = 16.0) -> AnimatedSprite2D:
+	var frames := CharacterFrames.frames_for(character)
+	if target == null or frames == null:
+		return null
+	var sprite = load("res://scripts/character_sprite.gd").new()
+	sprite.name = "CharacterSprite"
+	sprite.sprite_frames = frames
+	sprite.body = target
+	sprite.fit(height, feet_y)
+	target.add_child(sprite)
+	var old := target.get_node_or_null("Polygon2D")
+	if old is CanvasItem:
+		old.visible = false
+	sprite.play("idle_front")
+	return sprite
+
+
+# Criatura (ou personagem) sem corpo, a tocar uma animação.
+static func monster(parent: Node, animation: String = "idle_front", height: float = 110.0) -> AnimatedSprite2D:
+	var frames := CharacterFrames.frames_for("monster")
+	if parent == null or frames == null:
+		return null
+	var sprite = load("res://scripts/character_sprite.gd").new()
+	sprite.name = "MonsterSprite"
+	sprite.sprite_frames = frames
+	sprite.fit(height, height / 2.0)
+	parent.add_child(sprite)
+	sprite.play(animation)
+	return sprite
+
+
+func fit(height: float, feet_y: float) -> void:
+	var texture := sprite_frames.get_frame_texture("idle_front", 0)
+	var factor := height / float(texture.get_height())
+	scale = Vector2(factor, factor)
+	position = Vector2(0.0, feet_y - height / 2.0)
+	add_child(make_shadow(texture.get_height() * 0.2, texture.get_height() / 2.0 - 6.0))
+
+
+# Sombra oval debaixo dos pés, como nas folhas de sprites.
+func make_shadow(radius_x: float, offset_y: float) -> Node2D:
+	var shadow := Polygon2D.new()
+	shadow.name = "Shadow"
+	var points := PackedVector2Array()
+	for i in 20:
+		var angle := TAU * i / 20.0
+		points.append(Vector2(cos(angle) * radius_x, offset_y + sin(angle) * radius_x * 0.28))
+	shadow.polygon = points
+	shadow.color = Color(0.0, 0.0, 0.0, 0.28)
+	shadow.show_behind_parent = true
+	return shadow
+
+
+func _process(_delta: float) -> void:
+	if body == null or not is_instance_valid(body):
+		return
+	var velocity := body.velocity
+	var moving := velocity.length() > MOVE_THRESHOLD
+	if moving:
+		if abs(velocity.x) > abs(velocity.y):
+			facing = "side"
+		else:
+			facing = "back" if velocity.y < 0.0 else "front"
+		if abs(velocity.x) > MOVE_THRESHOLD:
+			facing_left = velocity.x < 0.0
+	var wanted := ("walk_" if moving else "idle_") + facing
+	if not sprite_frames.has_animation(wanted):
+		wanted = ("walk_" if moving else "idle_") + "front"
+	if animation != wanted:
+		play(wanted)
+	# As frames de lado olham para a direita; para a esquerda espelha.
+	flip_h = facing_left and facing == "side"
diff --git a/game/scripts/ui_sprite.gd b/game/scripts/ui_sprite.gd
new file mode 100644
index 0000000..1f9a223
--- /dev/null
+++ b/game/scripts/ui_sprite.gd
@@ -0,0 +1,54 @@
+extends TextureRect
+
+# Sprite animado para ecrãs de interface (encontro, fuga, luta, Game Over).
+# Usa as mesmas frames do mundo (character_frames.gd).
+
+const CharacterFrames := preload("res://scripts/character_frames.gd")
+
+var frames: SpriteFrames = null
+var animation: String = ""
+var frame_index: int = 0
+var frame_time: float = 0.0
+
+
+static func make(character: String, animation_name: String, height: float, flip: bool = false) -> TextureRect:
+	var sprite_frames := CharacterFrames.frames_for(character)
+	if sprite_frames == null or not sprite_frames.has_animation(animation_name):
+		return null
+	var rect = load("res://scripts/ui_sprite.gd").new()
+	rect.name = character.capitalize() + "Sprite"
+	rect.frames = sprite_frames
+	rect.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
+	rect.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
+	rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	rect.flip_h = flip
+	rect.process_mode = Node.PROCESS_MODE_ALWAYS
+	var first := sprite_frames.get_frame_texture(animation_name, 0)
+	rect.custom_minimum_size = Vector2(height * first.get_width() / first.get_height(), height)
+	rect.play(animation_name)
+	return rect
+
+
+func play(animation_name: String) -> void:
+	if frames == null or not frames.has_animation(animation_name) or animation == animation_name:
+		return
+	animation = animation_name
+	frame_index = 0
+	frame_time = 0.0
+	texture = frames.get_frame_texture(animation, 0)
+
+
+func _process(delta: float) -> void:
+	if frames == null or animation.is_empty():
+		return
+	var count := frames.get_frame_count(animation)
+	if count <= 1:
+		return
+	frame_time += delta
+	var step := 1.0 / frames.get_animation_speed(animation)
+	if frame_time >= step:
+		frame_time -= step
+		frame_index += 1
+		if frame_index >= count:
+			frame_index = 0 if frames.get_animation_loop(animation) else count - 1
+		texture = frames.get_frame_texture(animation, frame_index)
diff --git a/game/scripts/world_style.gd b/game/scripts/world_style.gd
new file mode 100644
index 0000000..45e2cf1
--- /dev/null
+++ b/game/scripts/world_style.gd
@@ -0,0 +1,260 @@
+extends Node
+
+# Estilo visual do mundo, a condizer com as folhas de sprites: contorno
+# preto grosso, cinzentos frios, amarelo-torrado e ciano como destaques.
+#
+# Não mexe em posições, colisões nem lógica. Percorre a cena e:
+#   - chãos das salas e corredores: cor nova + painéis metálicos com rebites;
+#   - bordas das salas e paredes: cinzento-metal com contorno preto;
+#   - restantes polígonos (terminais, portas, peças, destroços...): contorno
+#     preto à volta, como nos sprites;
+#   - nomes das salas: letra com contorno preto.
+# Objetos criados mais tarde (Phase 3, terminais, portas) são apanhados pelo
+# sinal node_added da árvore.
+
+const OUTLINE := Color(0.07, 0.07, 0.09)
+const FLOOR := Color(0.21, 0.23, 0.27)
+const FLOOR_IMPORTANT := Color(0.24, 0.26, 0.3)
+const CORRIDOR := Color(0.16, 0.17, 0.2)
+const SEAM := Color(0.12, 0.13, 0.15)
+const HIGHLIGHT := Color(1.0, 1.0, 1.0, 0.05)
+const RIVET := Color(0.4, 0.43, 0.48)
+const WALL := Color(0.45, 0.48, 0.53)
+const ACCENT := Color(0.88, 0.64, 0.17)
+
+const OUTLINE_WIDTH := 4.0
+const PANEL := 64.0
+
+var root: Node = null
+
+
+func _ready() -> void:
+	name = "WorldStyle"
+	root = get_parent()
+	get_tree().node_added.connect(_on_node_added)
+	call_deferred("style_tree", root)
+
+
+func _on_node_added(node: Node) -> void:
+	if root != null and is_instance_valid(root) and root.is_ancestor_of(node):
+		# Esperar que quem criou o nó lhe dê forma e cor.
+		call_deferred("style_node", node)
+
+
+func style_tree(node: Node) -> void:
+	style_node(node)
+	for child in node.get_children():
+		style_tree(child)
+
+
+func style_node(node: Node) -> void:
+	if node == null or not is_instance_valid(node) or node.has_meta("world_style"):
+		return
+	if node is Polygon2D:
+		style_polygon(node)
+	elif node is Line2D:
+		style_line(node)
+	elif node is Label and node.name == "RoomName":
+		style_room_label(node)
+
+
+func should_skip(node: CanvasItem) -> bool:
+	if not node.is_inside_tree():
+		return true
+	var parent := node.get_parent()
+	# Sprites (sombras), Player/Atlas (quadrado antigo), elementos de interface.
+	if parent is AnimatedSprite2D or parent is Sprite2D or parent is CharacterBody2D:
+		return true
+	if node.name == "Shadow" or node.name.begins_with("Outline"):
+		return true
+	return false
+
+
+func style_polygon(poly: Polygon2D) -> void:
+	if should_skip(poly) or poly.polygon.size() < 3:
+		return
+	poly.set_meta("world_style", true)
+	if poly.texture != null:
+		return
+	var parent_name := String(poly.get_parent().name)
+	if poly.name == "Floor":
+		var important := poly.color.is_equal_approx(Color(0.22, 0.27, 0.31, 1.0))
+		poly.color = FLOOR_IMPORTANT if important else FLOOR
+		add_panels(poly, PANEL)
+		return
+	if parent_name.begins_with("Corridor_"):
+		poly.color = CORRIDOR
+		add_panels(poly, PANEL / 2.0)
+		return
+	if poly.name == "Border":
+		poly.color = WALL
+		add_outline(poly, OUTLINE_WIDTH + 2.0)
+		return
+	# Superfície: a nave e os destroços passam aos cinzentos dos sprites e
+	# as peças a recolher ao amarelo do fato do Player.
+	if parent_name == "Ship":
+		poly.color = Color(0.4, 0.43, 0.48)
+	elif parent_name.begins_with("Debris"):
+		poly.color = Color(0.3, 0.31, 0.35)
+	elif parent_name.begins_with("ShipPart"):
+		poly.color = ACCENT
+		# Só contorna o que é sólido; zonas translúcidas (gatilhos, esconderijos,
+	# brilhos) ficam como estão.
+	if poly.color.a < 0.85 or not poly.visible:
+		return
+	if is_machine(poly):
+		dress_machine(poly)
+	add_outline(poly, OUTLINE_WIDTH)
+
+
+# Terminais e estações: painel grande e retangular dentro de um nó cujo nome
+# diz o que é. Ganham moldura, ecrã ciano e botões, como uma consola.
+func is_machine(poly: Polygon2D) -> bool:
+	var owner_name := String(poly.get_parent().name)
+	var machine := false
+	for word in ["Terminal", "Station", "Estacao", "Energy", "Equipment", "Map", "Console"]:
+		if owner_name.contains(word):
+			machine = true
+	if not machine:
+		return false
+	var bounds := polygon_bounds(poly.polygon)
+	return bounds.size.x >= 80.0 and bounds.size.y >= 50.0
+
+
+func dress_machine(poly: Polygon2D) -> void:
+	# A cor original passa a ser só um tom na moldura (cada terminal mantém a
+	# sua identidade de cor).
+	var tone := poly.color
+	poly.color = Color(0.28, 0.3, 0.34).lerp(tone, 0.35)
+	var decor := MachineDecor.new()
+	decor.name = "OutlineMachine"
+	decor.bounds = polygon_bounds(poly.polygon)
+	decor.tone = tone
+	decor.set_meta("world_style", true)
+	poly.add_child(decor)
+
+
+func style_line(line: Line2D) -> void:
+	if should_skip(line):
+		return
+	line.set_meta("world_style", true)
+	if String(line.get_parent().name) != "WallVisuals":
+		return
+	line.default_color = WALL
+	# Contorno preto por trás da parede.
+	var outline := Line2D.new()
+	outline.name = "OutlineWall"
+	outline.points = line.points
+	outline.width = line.width + OUTLINE_WIDTH * 2.0
+	outline.default_color = OUTLINE
+	outline.joint_mode = Line2D.LINE_JOINT_ROUND
+	outline.begin_cap_mode = Line2D.LINE_CAP_ROUND
+	outline.end_cap_mode = Line2D.LINE_CAP_ROUND
+	outline.show_behind_parent = true
+	outline.set_meta("world_style", true)
+	line.add_child(outline)
+
+
+func style_room_label(label: Label) -> void:
+	label.set_meta("world_style", true)
+	label.add_theme_color_override("font_color", Color(0.92, 0.9, 0.82))
+	label.add_theme_color_override("font_outline_color", OUTLINE)
+	label.add_theme_constant_override("outline_size", 8)
+	label.modulate.a = 0.75
+
+
+func add_outline(poly: Polygon2D, width: float) -> void:
+	var outline := Line2D.new()
+	outline.name = "Outline"
+	var points := poly.polygon.duplicate()
+	outline.points = points
+	outline.closed = true
+	outline.width = width
+	outline.default_color = OUTLINE
+	outline.joint_mode = Line2D.LINE_JOINT_ROUND
+	outline.position = poly.offset
+	outline.set_meta("world_style", true)
+	poly.add_child(outline)
+
+
+func add_panels(poly: Polygon2D, step: float) -> void:
+	var panels := FloorPanels.new()
+	panels.name = "OutlinePanels"
+	panels.bounds = polygon_bounds(poly.polygon)
+	panels.step = step
+	panels.set_meta("world_style", true)
+	poly.add_child(panels)
+
+
+static func polygon_bounds(points: PackedVector2Array) -> Rect2:
+	var rect := Rect2(points[0], Vector2.ZERO)
+	for point in points:
+		rect = rect.expand(point)
+	return rect
+
+
+# Painéis de metal desenhados por cima do chão (juntas, brilho e rebites).
+class FloorPanels extends Node2D:
+	var bounds: Rect2
+	var step: float = 64.0
+
+	func _draw() -> void:
+		var x := bounds.position.x
+		while x <= bounds.end.x + 0.1:
+			draw_line(Vector2(x, bounds.position.y), Vector2(x, bounds.end.y), SEAM, 2.0)
+			x += step
+		var y := bounds.position.y
+		while y <= bounds.end.y + 0.1:
+			draw_line(Vector2(bounds.position.x, y), Vector2(bounds.end.x, y), SEAM, 2.0)
+			draw_line(Vector2(bounds.position.x, y + 2.0), Vector2(bounds.end.x, y + 2.0), HIGHLIGHT, 1.0)
+			y += step
+		if step < 48.0:
+			return
+		x = bounds.position.x
+		while x < bounds.end.x:
+			y = bounds.position.y
+			while y < bounds.end.y:
+				for corner in [Vector2(6, 6), Vector2(step - 6, 6), Vector2(6, step - 6), Vector2(step - 6, step - 6)]:
+					var p: Vector2 = Vector2(x, y) + corner
+					if bounds.has_point(p):
+						draw_circle(p, 1.8, RIVET)
+				y += step
+			x += step
+
+
+# Ecrã, luzes e botões de uma consola.
+class MachineDecor extends Node2D:
+	var bounds: Rect2
+	var tone: Color
+	var clock: float = 0.0
+
+	func _process(delta: float) -> void:
+		clock += delta
+		queue_redraw()
+
+	func _draw() -> void:
+		var inset := 12.0
+		var screen := Rect2(bounds.position + Vector2(inset, inset), Vector2(bounds.size.x - inset * 2.0, bounds.size.y * 0.62))
+		draw_rect(screen, Color(0.04, 0.12, 0.14))
+		# Linhas do ecrã e um brilho que desce devagar.
+		var y := screen.position.y + 4.0
+		while y < screen.end.y:
+			draw_line(Vector2(screen.position.x, y), Vector2(screen.end.x, y), Color(0.25, 0.85, 0.85, 0.08), 1.0)
+			y += 6.0
+		var sweep := screen.position.y + fmod(clock * 30.0, screen.size.y)
+		draw_rect(Rect2(screen.position.x, sweep, screen.size.x, 6.0), Color(0.25, 0.85, 0.85, 0.12))
+		draw_rect(screen, OUTLINE, false, 3.0)
+		# Botões por baixo do ecrã.
+		var row_y := screen.end.y + (bounds.end.y - screen.end.y) / 2.0
+		var colors := [ACCENT, Color(0.25, 0.85, 0.85), Color(0.85, 0.3, 0.25)]
+		for i in 3:
+			var center := Vector2(bounds.position.x + inset + 10.0 + i * 22.0, row_y)
+			var lit := fmod(clock + i * 0.7, 2.0) < 1.4
+			draw_circle(center, 6.0, OUTLINE)
+			draw_circle(center, 4.5, colors[i] if lit else colors[i].darkened(0.6))
+		# Grelha de ventilação à direita.
+		for i in 4:
+			var x := bounds.end.x - inset - 8.0 - i * 9.0
+			draw_line(Vector2(x, row_y - 7.0), Vector2(x, row_y + 7.0), OUTLINE, 3.0)
+		# Faixa de cor do terminal.
+		draw_rect(Rect2(bounds.position.x, bounds.end.y - 6.0, bounds.size.x, 6.0), tone)
