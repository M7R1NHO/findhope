+class AndroidButton extends Button:
+	var unread: int = 0
+	var pulse: float = 0.0
+
+	func _process(delta: float) -> void:
+		if unread > 0:
+			pulse = fmod(pulse + delta * 2.5, TAU)
+			queue_redraw()
+
+	func _draw() -> void:
+		var center := size / 2.0
+		var radius: float = min(size.x, size.y) / 2.0 - 2.0
+		var hovered := is_hovered()
+		var accent: Color = UIStyle.ACCENT
+
