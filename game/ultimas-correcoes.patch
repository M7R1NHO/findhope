index 0000000..ce8d1b1
--- /dev/null
+++ b/ferramentas_ultimas/2_banda_sonora.py
@@ -0,0 +1,218 @@
+"""Banda sonora original do Find Hope (ciclo contínuo).
+
+Gera game/audio/music/find_hope_theme.ogg só com síntese (numpy) e ffmpeg:
+não usa samples nem música de terceiros.
+
+Música: 80 BPM, 16 compassos (48 s), lá menor com um final em Mi maior que
+volta ao início. Camadas: pad quente, baixo suave, arpejo "de sonar",
+sinos raros e vento filtrado (o planeta).
+
+Ciclo sem cortes: tudo é calculado de forma CIRCULAR. Uma nota que passa do
+fim do ciclo continua no início, o eco é uma rotação e a reverberação é uma
+convolução circular (FFT do tamanho exato do ciclo). Assim a última amostra
+liga à primeira sem clique nem silêncio.
+
+Uso: python3 ferramentas_ultimas/2_banda_sonora.py [pasta_do_jogo]
+"""
+import os
+import subprocess
+import sys
+import wave
+
+import numpy as np
+
+RATE = 44100
+BPM = 80
+BEAT = 60.0 / BPM
+BARS = 16
+LOOP_SECONDS = BARS * 4 * BEAT
+N = int(round(LOOP_SECONDS * RATE))
+rng = np.random.default_rng(47)  # Nave 47: sempre o mesmo ficheiro
+
+# Acordes (notas MIDI), dois compassos cada.
+PROGRESSION = [
+    [57, 60, 64, 69],  # Lá m
+    [53, 57, 60, 65],  # Fá
+    [48, 55, 60, 64],  # Dó
+    [55, 59, 62, 67],  # Sol
+    [57, 60, 64, 69],  # Lá m
+    [53, 57, 60, 65],  # Fá
+    [50, 57, 62, 65],  # Ré m
+    [52, 56, 59, 64],  # Mi (volta ao Lá m)
+]
+
+
+def freq(midi):
+    return 440.0 * 2.0 ** ((midi - 69) / 12.0)
+
+
+def place(buffer, start, signal):
+    """Soma signal em buffer a partir de start, a dar a volta ao ciclo."""
+    start %= N
+    end = start + len(signal)
+    if end <= N:
+        buffer[start:end] += signal
+    else:
+        first = N - start
+        buffer[start:] += signal[:first]
+        rest = signal[first:]
+        while len(rest) > 0:
+            take = min(N, len(rest))
+            buffer[:take] += rest[:take]
+            rest = rest[take:]
+
+
+def envelope(length, attack, release):
+    env = np.ones(length)
+    a = max(1, int(attack * RATE))
+    r = max(1, int(release * RATE))
+    env[:a] = np.linspace(0.0, 1.0, a) ** 2
+    env[-r:] *= np.linspace(1.0, 0.0, r) ** 2
+    return env
+
+
+def soft_saw(f, length, harmonics=7, detune=0.0):
+    t = np.arange(length) / RATE
+    out = np.zeros(length)
+    for k in range(1, harmonics + 1):
+        out += np.sin(2 * np.pi * f * k * (1 + detune) * t + k * 0.7) / (k ** 1.6)
+    return out
+
+
+def pad_layer():
+    left = np.zeros(N)
+    right = np.zeros(N)
+    chord_len = 8 * BEAT
+    for i, chord in enumerate(PROGRESSION):
+        start = int(i * chord_len * RATE)
+        length = int((chord_len + 2.5) * RATE)  # sobrepõe-se ao seguinte
+        env = envelope(length, 1.6, 2.8)
+        for j, note in enumerate(chord):
+            f = freq(note - 12 if j == 0 else note)
+            gain = 0.11 if j == 0 else 0.07
+            left_note = soft_saw(f, length, detune=-0.0025) * gain * env
+            right_note = soft_saw(f, length, detune=0.0025) * gain * env
+            place(left, start, left_note)
+            place(right, start, right_note)
+    return left, right
+
+
+def bass_layer():
+    out = np.zeros(N)
+    for i, chord in enumerate(PROGRESSION):
+        root = freq(chord[0] - 24)
+        for beat in (0, 3, 4, 7):
+            start = int((i * 8 + beat) * BEAT * RATE)
+            length = int(BEAT * 1.6 * RATE)
+            t = np.arange(length) / RATE
+            env = np.exp(-t * 2.2) * envelope(length, 0.02, 0.3)
+            tone = np.sin(2 * np.pi * root * t) + 0.25 * np.sin(4 * np.pi * root * t)
+            place(out, start, tone * env * 0.22)
+    return out
+
+
+def arp_layer():
+    left = np.zeros(N)
+    right = np.zeros(N)
+    pattern = [0, 1, 2, 3, 2, 1, 3, 2]
+    for bar in range(BARS):
+        chord = PROGRESSION[bar // 2]
+        # O arpejo descansa nos compassos 1 e 9 (respira no início das frases).
+        if bar % 8 == 0:
+            continue
+        for step in range(8):
+            note = chord[pattern[step]] + 12
+            start = int((bar * 4 + step * 0.5) * BEAT * RATE)
+            length = int(1.4 * RATE)
+            t = np.arange(length) / RATE
+            env = np.exp(-t * 4.5) * envelope(length, 0.004, 0.2)
+            f = freq(note)
+            tone = np.sin(2 * np.pi * f * t) + 0.3 * np.sin(4 * np.pi * f * t) * np.exp(-t * 9)
+            gain = 0.055 if step % 2 == 0 else 0.04
+            pan = 0.35 if step % 2 == 0 else -0.35
+            place(left, start, tone * env * gain * (1 - pan))
+            place(right, start, tone * env * gain * (1 + pan))
+    return left, right
+
+
+def bell_layer():
+    out = np.zeros(N)
+    for bar, note in [(3, 81), (7, 79), (11, 84), (15, 76)]:
+        start = int((bar * 4 + 2) * BEAT * RATE)
+        length = int(4.0 * RATE)
+        t = np.arange(length) / RATE
+        f = freq(note)
+        tone = (np.sin(2 * np.pi * f * t) + 0.5 * np.sin(2 * np.pi * f * 2.76 * t) * np.exp(-t * 2)
+                + 0.25 * np.sin(2 * np.pi * f * 5.4 * t) * np.exp(-t * 4))
+        place(out, start, tone * np.exp(-t * 1.1) * envelope(length, 0.003, 0.5) * 0.05)
+    return out
+
+
+def wind_layer():
+    noise = rng.standard_normal(N)
+    # Filtro passa-baixo circular (no domínio da frequência) e um vaivém lento.
+    spectrum = np.fft.rfft(noise)
+    freqs = np.fft.rfftfreq(N, 1.0 / RATE)
+    spectrum *= 1.0 / (1.0 + (freqs / 500.0) ** 2)
+    spectrum[freqs < 60] = 0
+    wind = np.fft.irfft(spectrum, N)
+    wind /= np.max(np.abs(wind))
+    t = np.arange(N) / RATE
+    swell = 0.55 + 0.45 * np.sin(2 * np.pi * t / LOOP_SECONDS * 4 + 1.0)
+    return wind * swell * 0.035
+
+
+def circular_reverb(signal, seconds=2.4, mix=0.32, seed=0):
+    local = np.random.default_rng(seed)
+    length = int(seconds * RATE)
+    t = np.arange(length) / RATE
+    impulse = local.standard_normal(length) * np.exp(-t * 3.0 / seconds)
+    impulse[0] = 0.0
+    impulse /= np.sqrt(np.sum(impulse ** 2))
+    kernel = np.zeros(N)
+    kernel[:length] = impulse
+    wet = np.fft.irfft(np.fft.rfft(signal) * np.fft.rfft(kernel), N)
+    return signal * (1 - mix) + wet * mix
+
+
+def echo(signal, delay_beats=0.75, feedback=0.35, repeats=4):
+    out = signal.copy()
+    shift = int(delay_beats * BEAT * RATE)
+    for k in range(1, repeats + 1):
+        out += np.roll(signal, shift * k) * feedback ** k
+    return out
+
+
+def main():
+    game_dir = sys.argv[1] if len(sys.argv) > 1 else os.path.join(os.path.dirname(__file__), "..", "game")
+    pad_l, pad_r = pad_layer()
+    arp_l, arp_r = arp_layer()
+    bass = bass_layer()
+    bells = bell_layer()
+    wind = wind_layer()
+    left = pad_l + echo(arp_l) + bass + bells + wind
+    right = pad_r + echo(np.roll(arp_r, int(BEAT * 0.25 * RATE))) + bass + np.roll(bells, 900) + np.roll(wind, RATE // 3)
+    left = circular_reverb(left, seed=1)
+    right = circular_reverb(right, seed=2)
+    stereo = np.stack([left, right], axis=1)
+    stereo = np.tanh(stereo / np.max(np.abs(stereo)) * 1.15)
+    stereo *= 0.89 / np.max(np.abs(stereo))  # cerca de -1 dBFS
+
+    out_dir = os.path.join(game_dir, "audio", "music")
+    os.makedirs(out_dir, exist_ok=True)
+    wav_path = os.path.join(out_dir, "find_hope_theme.wav")
+    ogg_path = os.path.join(out_dir, "find_hope_theme.ogg")
+    pcm = (stereo * 32767).astype("<i2")
+    with wave.open(wav_path, "wb") as handle:
+        handle.setnchannels(2)
+        handle.setsampwidth(2)
+        handle.setframerate(RATE)
+        handle.writeframes(pcm.tobytes())
+    subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-i", wav_path, "-c:a", "libvorbis", "-q:a", "5", ogg_path], check=True)
+    os.remove(wav_path)
+    jump = np.max(np.abs(stereo[0] - stereo[-1]))
+    print("Gerado:", ogg_path, "| %.1f s | %d amostras | salto no ciclo: %.4f" % (LOOP_SECONDS, N, jump))
+
+
+if __name__ == "__main__":
+    main()
