+# =========================================================
+
+func set_player_protected(reason: String, active: bool) -> void:
+	if active:
+		protection_reasons[reason] = true
+		abort_active_threats()
+	else:
+		protection_reasons.erase(reason)
+		# Ao sair da proteção, o temporizador da sala recomeça do zero.
