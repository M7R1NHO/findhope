+"""Últimas correções: sprite do Player de costas (andar para cima).
+
+Entrada: player_costas_original.png (captura enviada pelo utilizador em
+25/10/2026, com o fundo quadriculado do editor de imagem por trás).
+Saída: game/sprites/characters/player/back_0..back_4.png
+
+1. Tira o fundo quadriculado: enchimento a partir das bordas por píxeis
+   claros e cinzentos (sem cor), que param no contorno preto da personagem.
+2. Recorta e põe à escala das outras vistas (o mesmo tamanho de tela, 70x131,
+   com os pés na última linha, como front_0).
+3. Frames do andar: a mesma lógica do andar para baixo (front_1..4):
+   1 = perna esquerda levantada, 2 = passada neutra, 3 = perna direita
+   levantada, 4 = passada neutra; o corpo sobe 1 px nas passadas neutras.
+   De costas, a perna levantada fica mais curta (o pé sobe), como nas
+   frames de frente.
+
+    python3 ferramentas_ultimas/1_player_costas.py
+"""
+import os
+import sys
+from collections import deque
+from PIL import Image
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(HERE)
+SOURCE = os.path.join(HERE, "player_costas_original.png")
+OUT = os.path.join(ROOT, "game", "sprites", "characters", "player")
+CANVAS = (70, 131)
+
+
+def is_background(pixel):
+    r, g, b, a = pixel
+    return a == 0 or (min(r, g, b) >= 188 and max(r, g, b) - min(r, g, b) <= 14)
+
+
+def remove_checkerboard(image):
+    image = image.convert("RGBA")
+    width, height = image.size
+    pixels = image.load()
+    seen = set()
+    queue = deque()
+    for x in range(width):
+        queue.extend([(x, 0), (x, height - 1)])
+    for y in range(height):
+        queue.extend([(0, y), (width - 1, y)])
+    while queue:
+        x, y = queue.popleft()
+        if (x, y) in seen or not (0 <= x < width and 0 <= y < height):
+            continue
+        seen.add((x, y))
+        if not is_background(pixels[x, y]):
+            continue
+        pixels[x, y] = (0, 0, 0, 0)
+        queue.extend([(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)])
+    # Orla clara (anti-serrilhado entre o contorno e o fundo): dois passes,
+    # mais transparente quanto mais clara.
+    for _ in range(2):
+        clear = {(x, y) for y in range(height) for x in range(width) if pixels[x, y][3] == 0}
+        for y in range(height):
+            for x in range(width):
+                r, g, b, a = pixels[x, y]
+                if a == 0:
+                    continue
+                near_clear = any((x + dx, y + dy) in clear for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)))
+                if near_clear and min(r, g, b) > 110 and max(r, g, b) - min(r, g, b) <= 28:
+                    alpha = int(255 * max(0.0, min(1.0, (215 - min(r, g, b)) / 105.0)))
+                    pixels[x, y] = (r, g, b, alpha)
+    return image
+
+
+def fit_to_canvas(image, reference):
+    box = image.getbbox()
+    image = image.crop(box)
+    ref_box = reference.getbbox()
+    target_height = ref_box[3] - ref_box[1]
+    scale = target_height / image.height
+    size = (max(1, round(image.width * scale)), target_height)
+    image = image.resize(size, Image.LANCZOS)
+    canvas = Image.new("RGBA", (max(CANVAS[0], image.width), CANVAS[1]), (0, 0, 0, 0))
+    canvas.alpha_composite(image, ((canvas.width - image.width) // 2, CANVAS[1] - image.height))
+    return canvas
+
+
+def leg_lift(image, side, lift):
+    """Levanta uma perna: a metade (esquerda/direita) da zona das pernas sobe
+    "lift" px e fica mais curta; o resto do corpo não mexe."""
+    box = image.getbbox()
+    width = image.width
+    legs_top = box[1] + int((box[3] - box[1]) * 0.70)
+    middle = (box[0] + box[2]) // 2
+    left, right = (0, middle) if side == "left" else (middle, width)
+    leg = image.crop((left, legs_top, right, image.height))
+    out = image.copy()
+    out.paste((0, 0, 0, 0), (left, legs_top, right, image.height))
+    squashed = leg.resize((leg.width, max(1, leg.height - lift)), Image.LANCZOS)
+    out.alpha_composite(squashed, (left, legs_top))
+    return out
+
+
+def bob(image, pixels):
+    out = Image.new("RGBA", image.size, (0, 0, 0, 0))
+    out.alpha_composite(image.crop((0, pixels, image.width, image.height)), (0, 0))
+    return out
+
+
+def main():
+    if not os.path.exists(SOURCE):
+        sys.exit("Falta " + SOURCE)
+    reference = Image.open(os.path.join(OUT, "front_0.png")).convert("RGBA")
+    idle = fit_to_canvas(remove_checkerboard(Image.open(SOURCE)), reference)
+    frames = [
+        idle,
+        leg_lift(idle, "left", 7),
+        bob(idle, 1),
+        leg_lift(idle, "right", 7),
+        bob(idle, 1),
+    ]
+    for index, frame in enumerate(frames):
+        frame.save(os.path.join(OUT, "back_%d.png" % index))
+        print("back_%d.png" % index, frame.size, frame.getbbox())
+
+
+if __name__ == "__main__":
+    main()
