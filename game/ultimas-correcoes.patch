+	show_hide_spots(current_room_id, false)
+	destroy_hide_ui()
+	hide_event_active = false
+	hide_phase = HidePhase.NONE
+	active_hide_spot = null
+	if atlas != null and is_instance_valid(atlas) and atlas.has_method("stop_scripted_move_to"):
